{
  // Replicates the GitHub Actions repology-export job environment.
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "17"
    }
  },
  "forwardPorts": [5433],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo pg_ctlcluster 17 main start 2>/dev/null || true"
}
