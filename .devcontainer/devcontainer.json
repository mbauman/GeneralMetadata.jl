{
  // Replicates the GitHub Actions repology-export job environment.
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/julia:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "17"
    }
  },
  "forwardPorts": [5433],
  "postCreateCommand": "julia --project=. -e 'using Pkg; Pkg.instantiate()'"
}
